<Window x:Class="CustomVigenereCypher.VigenereMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomVigenereCypher"
        mc:Ignorable="d"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Custom Vigenere Cipher" Height="450" Width="800">
    <Grid Background="#FF182C42">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="542*"/>
            <ColumnDefinition Width="259*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ResultingMessageTextBox" BorderThickness="0" Margin="0,42,42,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="200" Initialized="ResultingMessageTextBox_Initialized" Cursor="IBeam" Background="White" Foreground="#BF323232" FontFamily="Dubai" Padding="5,5,5,5" FontSize="14" SelectionBrush="#FF0078D7" SelectionTextBrush="#FF0078D7" BorderBrush="{x:Null}" HorizontalAlignment="Right" Width="200" FontWeight="Bold" Grid.Column="1">
            <TextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </TextBox.Resources>
        </TextBox>
        <Button x:Name="SwapButton" Content="Swap" HorizontalAlignment="Left" Margin="372,181,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="14" FontWeight="Bold" BorderBrush="Black" Foreground="White" Background="#FF3671B0" Padding="10" BorderThickness="0,0,0,0" Cursor="Hand" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" HorizontalContentAlignment="Center" MaxWidth="200" MaxHeight="50" Click="SwapButton_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <Border BorderThickness="0.5,0,0.5,1" Height="42" Margin="300,89,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="18*"/>
                    <RowDefinition Height="23*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="EnterCypherKeyTextBox" BorderThickness="0" Margin="0,0,0,2" TextWrapping="NoWrap" Background="White" FontFamily="Arial" HorizontalContentAlignment="Stretch" Padding="2,2,2,0" Grid.IsSharedSizeScope="True" FontSize="13" TextChanged="EnterCypherKeyTextBox_TextChanged" FontWeight="Bold" RenderTransformOrigin="0.496,0.712" ScrollViewer.CanContentScroll="True" BorderBrush="Black" SelectionBrush="Black" SelectionTextBrush="#FF0078D7" Foreground="#BF323232" Grid.Row="1" Initialized="EnterCypherKeyTextBox_Initialized" MaxWidth="200" LostKeyboardFocus="EnterCypherKeyTextBox_LostKeyboardFocus_1">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="0,0,5,5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <Label Content="KEY" BorderThickness="0,2,0,1" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="5,0,5,0" Width="200" Height="22" Background="White" Foreground="#BF323232" FontFamily="Dubai" FontSize="13" FontWeight="Bold" HorizontalContentAlignment="Stretch" UseLayoutRounding="False" BorderBrush="Black" Margin="0,-4,0,0" />
                <Label Content="ALPHABET" BorderThickness="0,0,0,1" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="5,0,5,0" Width="200" Height="22" Background="White" Foreground="#BF323232" FontFamily="Dubai" FontSize="13" FontWeight="Bold" HorizontalContentAlignment="Stretch" UseLayoutRounding="False" BorderBrush="Black" Margin="0,-47,0,0">
                    <Label.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5,5,0,0"/>
                        </Style>
                    </Label.Resources>
                </Label>
                <TextBox x:Name="EnterAplhabetTextBox" BorderThickness="0" Margin="0,-25,0,22" TextWrapping="NoWrap" Background="White" FontFamily="Arial" HorizontalContentAlignment="Stretch" Padding="2,2,2,0" FontSize="13" FontWeight="Bold" RenderTransformOrigin="0.496,0.712" ScrollViewer.CanContentScroll="True" BorderBrush="Black" SelectionBrush="#FF0078D7" SelectionTextBrush="#FF0078D7" Foreground="#BF323232" Initialized="EnterAplhabetTextBox_Initialized" TextChanged="EnterAplhabetTextBox_TextChanged" Grid.IsSharedSizeScope="True" HorizontalScrollBarVisibility="Hidden" UseLayoutRounding="False" MaxWidth="200" LostKeyboardFocus="EnterAplhabetTextBox_LostKeyboardFocus" />
            </Grid>
        </Border>
        <xctk:WatermarkTextBox x:Name="EnterMessageTextBox" Watermark="Enter message to encrypt" Margin="42,42,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" Height="200" Background="White" Foreground="#BF323232" FontFamily="Dubai" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Padding="5,5,5,5" Grid.IsSharedSizeScope="True" RenderTransformOrigin="0.5,0.5" BorderBrush="{x:Null}" FontSize="14" FontWeight="Bold" TextChanged="EnterMessageTextBox_TextChanged" BorderThickness="0,0,0,0" SelectionBrush="#FF0078D7">
            <xctk:WatermarkTextBox.SelectionTextBrush>
                <SolidColorBrush Color="#FF0078D7"/>
            </xctk:WatermarkTextBox.SelectionTextBrush>
            <xctk:WatermarkTextBox.WatermarkTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" FontFamily="Dubai" Foreground="#BF2F2F2F" Focusable="False" />
                </DataTemplate>
            </xctk:WatermarkTextBox.WatermarkTemplate>
        </xctk:WatermarkTextBox>
        <Label x:Name="DuplicatesWarningLabel" Content="Must not contain duplicates!&#xD;&#xA;" HorizontalAlignment="Left" Margin="372,46,0,0" VerticalAlignment="Top" Padding="0,0,0,0" FontSize="9" Height="14" Width="111" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Dubai" FontWeight="Bold" Foreground="#FFE81414" Visibility="Hidden"/>
    </Grid>
</Window>
