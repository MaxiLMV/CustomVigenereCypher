<Window x:Class="CustomVigenereCypher.VigenereMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomVigenereCypher"
        mc:Ignorable="d"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Custom Vigenere Cipher" Height="450" Width="800">
    <Grid Background="#FF182C42">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label x:Name="EnterMessageLabel" Content="MESSAGE TO ENCRYPT" VerticalAlignment="Top" Foreground="White" FontFamily="Arial" FontWeight="Bold" FontSize="9" HorizontalAlignment="Left" Margin="462,10,0,0"/>
        <TextBox x:Name="ResultingMessageTextBox" HorizontalAlignment="Left" Margin="462,240,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Height="120" Initialized="ResultingMessageTextBox_Initialized" Cursor="Arrow" Background="#FF3671B0" Foreground="White" FontFamily="Arial" Padding="5,5,5,5" FontSize="9"/>
        <Button x:Name="SwapButton" Content="Swap" HorizontalAlignment="Left" Margin="705,170,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="14" FontWeight="Bold" BorderBrush="Black" Foreground="White" Background="#FF3671B0" Padding="10" BorderThickness="0,0,0,0" Cursor="Hand" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" HorizontalContentAlignment="Center" MaxWidth="200" MaxHeight="50" Click="SwapButton_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button x:Name="ConverterButton" Content="Encrypt" HorizontalAlignment="Left" Margin="561,170,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="14" FontWeight="Bold" BorderBrush="Black" Foreground="White" Background="#FF3671B0" Padding="10" BorderThickness="0,0,0,0" Cursor="Hand" Width="94" Click="ConverterButton_Click">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <Label x:Name="ResultingMessageLabel" Content="RESULTING MESSAGE" VerticalAlignment="Top" Foreground="White" FontFamily="Arial" FontSize="9" HorizontalAlignment="Left" Margin="462,220,0,0" FontWeight="Bold"/>
        <xctk:WatermarkTextBox x:Name="EnterCypherKeyTextBox" Watermark="Enter the key here" Margin="400,170,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="140" Height="36" Background="#FF3671B0" Foreground="White" FontFamily="Arial" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Padding="5,5,5,5" Grid.IsSharedSizeScope="True" FontSize="9">
            <xctk:WatermarkTextBox.WatermarkTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" FontFamily="Arial" Foreground="White" FontWeight="Bold" Focusable="False" />
                </DataTemplate>
            </xctk:WatermarkTextBox.WatermarkTemplate>
        </xctk:WatermarkTextBox>
        <xctk:WatermarkTextBox x:Name="EnterMessageTextBox" Watermark="Enter your message here" Margin="462,30,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Height="124" Background="#FF3671B0" Foreground="White" FontFamily="Arial" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Padding="5,5,5,5" Grid.IsSharedSizeScope="True" FontSize="9" RenderTransformOrigin="0.5,0.5">
            <xctk:WatermarkTextBox.WatermarkTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" FontFamily="Arial" Foreground="White" FontWeight="Bold" Focusable="False" />
                </DataTemplate>
            </xctk:WatermarkTextBox.WatermarkTemplate>
        </xctk:WatermarkTextBox>
    </Grid>
</Window>
