<Window x:Class="CustomVigenereCypher.VigenereMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomVigenereCypher"
        mc:Ignorable="d"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Custom Vigenere Cipher" Height="450" Width="800">
    <Grid Background="#FF182C42">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ResultingMessageTextBox" BorderThickness="0" Margin="0,42,42,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="200" Initialized="ResultingMessageTextBox_Initialized" Cursor="Arrow" Background="White" Foreground="#BF323232" FontFamily="Dubai" Padding="5,5,5,5" FontSize="16" SelectionBrush="{x:Null}" SelectionTextBrush="{x:Null}" BorderBrush="{x:Null}" HorizontalAlignment="Right" Width="200" FontWeight="Bold">
            <TextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </TextBox.Resources>
        </TextBox>
        <Button x:Name="SwapButton" Content="Swap" HorizontalAlignment="Center" Margin="0,282,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="14" FontWeight="Bold" BorderBrush="Black" Foreground="White" Background="#FF3671B0" Padding="10" BorderThickness="0,0,0,0" Cursor="Hand" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" HorizontalContentAlignment="Center" MaxWidth="200" MaxHeight="50" Click="SwapButton_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <Border BorderThickness="0.5,0,0.5,1" Height="42" Margin="0,42,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid>
                <TextBox x:Name="EnterCypherKeyTextBox" BorderThickness="0" Margin="0,22,0,-2" TextWrapping="Wrap" Background="White" FontFamily="Arial" HorizontalContentAlignment="Stretch" Padding="2,2,2,0" Grid.IsSharedSizeScope="True" FontSize="14" TextChanged="EnterCypherKeyTextBox_TextChanged" FontWeight="Bold" RenderTransformOrigin="0.496,0.712" ScrollViewer.CanContentScroll="True" BorderBrush="Black" SelectionBrush="{x:Null}" SelectionTextBrush="{x:Null}" Foreground="#BF323232">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="0,0,5,5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <Label Content="KEY" BorderThickness="0,0,0,1" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="5,0,5,0" Width="200" Height="22" Background="White" Foreground="#BF323232" FontFamily="Dubai" FontSize="14" FontWeight="Bold" HorizontalContentAlignment="Stretch" UseLayoutRounding="False" BorderBrush="Black">
                    <Label.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5,5,0,0"/>
                        </Style>
                    </Label.Resources>
                </Label>
            </Grid>
        </Border>
        <xctk:WatermarkTextBox x:Name="EnterMessageTextBox" Watermark="Enter message to encrypt" Margin="42,42,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" Height="200" Background="White" Foreground="#BF323232" FontFamily="Dubai" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Padding="5,5,5,5" Grid.IsSharedSizeScope="True" RenderTransformOrigin="0.5,0.5" SelectionTextBrush="{x:Null}" BorderBrush="{x:Null}" FontSize="16" FontWeight="Bold" TextChanged="EnterMessageTextBox_TextChanged" BorderThickness="0,0,0,0" SelectionBrush="{x:Null}">
            <xctk:WatermarkTextBox.WatermarkTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" FontFamily="Dubai" Foreground="#BF2F2F2F" Focusable="False" />
                </DataTemplate>
            </xctk:WatermarkTextBox.WatermarkTemplate>
            <xctk:WatermarkTextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5,5,0,0"/>
                </Style>
            </xctk:WatermarkTextBox.Resources>
        </xctk:WatermarkTextBox>
    </Grid>
</Window>
