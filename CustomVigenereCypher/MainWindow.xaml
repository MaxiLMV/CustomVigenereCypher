<Window x:Class="CustomVigenereCypher.VigenereMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomVigenereCypher"
        mc:Ignorable="d"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Custom Vigenere Cipher" Height="450" Width="800">
    <Grid Background="#FF182C42">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <xctk:WatermarkTextBox Watermark="Enter your message here" HorizontalAlignment="Left" Margin="60,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Height="150" Background="#FF3671B0" Foreground="White" FontFamily="Arial">
            <xctk:WatermarkTextBox.WatermarkTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" FontFamily="Arial" Foreground="White" FontWeight="Bold" Focusable="False" />
                </DataTemplate>
            </xctk:WatermarkTextBox.WatermarkTemplate>
        </xctk:WatermarkTextBox>
        <Label Content="MESSAGE TO ENCRYPT" VerticalAlignment="Top" Foreground="White" FontFamily="Arial" FontWeight="Bold" FontSize="14" HorizontalAlignment="Left" Margin="123,31,0,0"/>
        <TextBox x:Name="ResultingMessage" HorizontalAlignment="Left" Margin="440,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Height="150" Initialized="ResultingMessage_Initialized" Cursor="Arrow" Background="#FF3671B0"/>
        <Button Content="Switch to Decrypter" HorizontalAlignment="Center" Margin="0,316,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="14" FontWeight="Bold" BorderBrush="Black" Foreground="White" Background="#FF3671B0" Padding="10" BorderThickness="0,0,0,0" Cursor="Hand" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" HorizontalContentAlignment="Center" MaxWidth="200" MaxHeight="50">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button x:Name="ConverterButton" Content="Encrypt" HorizontalAlignment="Center" Margin="0,260,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="14" FontWeight="Bold" BorderBrush="Black" Foreground="White" Background="#FF3671B0" Padding="10" BorderThickness="0,0,0,0" Cursor="Hand" ClickMode="Hover">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <Label Content="RESULTING MESSAGE" VerticalAlignment="Top" Foreground="White" FontFamily="Arial" FontWeight="Bold" FontSize="14" HorizontalAlignment="Left" Margin="508,31,0,0"/>
    </Grid>
</Window>
