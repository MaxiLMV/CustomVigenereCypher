<Window x:Class="CustomVigenereCypher.VigenereMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomVigenereCypher"
        mc:Ignorable="d"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Custom Vigenere Cipher" Height="450" Width="800">
    <Grid Background="#FFF2F4F6">
        <TextBox x:Name="ResultingMessageTextBox" BorderThickness="0.5,0.5,0.5,0.5" Margin="0,42,42,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="200" Initialized="ResultingMessageTextBox_Initialized" Cursor="IBeam" Background="White" Foreground="#BF323232" FontFamily="Dubai" Padding="5,5,5,5" FontSize="14" SelectionBrush="#FF0078D7" SelectionTextBrush="#FF0078D7" BorderBrush="Black" HorizontalAlignment="Right" Width="200" FontWeight="Bold">
            <TextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </TextBox.Resources>
        </TextBox>
        <Button x:Name="SwapButton" Content="Swap" HorizontalAlignment="Center" Margin="0,267,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="14" FontWeight="Bold" BorderBrush="Black" Foreground="White" Background="#FF468FDC" Padding="10" BorderThickness="0,0,0,0" Cursor="Hand" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" HorizontalContentAlignment="Center" MaxWidth="200" MaxHeight="50" Click="SwapButton_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <TextBox x:Name="EnterMessageTextBox" Margin="42,42,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" Height="200" Background="White" Foreground="#BF323232" FontFamily="Dubai" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Padding="5,5,5,5" Grid.IsSharedSizeScope="True" RenderTransformOrigin="0.5,0.5" BorderBrush="Black" FontSize="14" FontWeight="Bold" TextChanged="EnterMessageTextBox_TextChanged" BorderThickness="0.5,0.5,0.5,0.5" SelectionBrush="#FF0078D7">
            <TextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </TextBox.Resources>
        </TextBox>
        <Label x:Name="DuplicatesWarningLabel" Content="Must not contain duplicates!&#xD;&#xA;" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="0,0,0,0" FontSize="9" Height="14" Width="111" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Dubai" FontWeight="Bold" Foreground="#FFBB3535" Visibility="Visible" Margin="376,46,0,0" Panel.ZIndex="3" Background="{x:Null}"/>
        <Grid HorizontalAlignment="Center" Height="129" Margin="0,42,0,0" VerticalAlignment="Top" Width="200">
            <TextBox x:Name="EnterCypherKeyTextBox" BorderThickness="0.5,0,0.5,0.5" Margin="0,65,0,43" TextWrapping="NoWrap" Background="White" FontFamily="Arial" HorizontalContentAlignment="Stretch" Padding="2,2,2,0" Grid.IsSharedSizeScope="True" FontSize="13" TextChanged="EnterCypherKeyTextBox_TextChanged" FontWeight="Bold" RenderTransformOrigin="0.496,0.712" ScrollViewer.CanContentScroll="True" BorderBrush="Black" SelectionBrush="Black" SelectionTextBrush="#FF0078D7" Foreground="#BF323232" Initialized="EnterCypherKeyTextBox_Initialized" MaxWidth="200" LostKeyboardFocus="EnterCypherKeyTextBox_LostKeyboardFocus_1" Height="21" />
            <Label Content="KEY" BorderThickness="0.5,0.5,0.5,1" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="5,0,5,0" Width="200" Height="22" Background="#FF468FDC" Foreground="#FFFFFFFA" FontFamily="Dubai" FontSize="13" FontWeight="Bold" HorizontalContentAlignment="Stretch" UseLayoutRounding="False" BorderBrush="Black" Margin="0,43,0,0" />
            <Label Content="ALPHABET" BorderThickness="0.5,0.5,0.5,1" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="5,0,5,0" Width="200" Height="22" Background="#FF468FDC" Foreground="#FFFFFFFA" FontFamily="Dubai" FontSize="13" FontWeight="Bold" HorizontalContentAlignment="Stretch" UseLayoutRounding="False" BorderBrush="Black">
                <Label.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="5,5,0,0"/>
                    </Style>
                </Label.Resources>
            </Label>
            <TextBox x:Name="EnterAplhabetTextBox" BorderThickness="0.5,0,0.5,0.5" Margin="0,22,0,86" TextWrapping="NoWrap" Background="White" FontFamily="Arial" HorizontalContentAlignment="Stretch" Padding="2,2,2,0" FontSize="13" FontWeight="Bold" RenderTransformOrigin="0.496,0.712" ScrollViewer.CanContentScroll="True" BorderBrush="Black" SelectionBrush="#FF0078D7" SelectionTextBrush="#FF0078D7" Foreground="#BF323232" Initialized="EnterAplhabetTextBox_Initialized" TextChanged="EnterAplhabetTextBox_TextChanged" Grid.IsSharedSizeScope="True" HorizontalScrollBarVisibility="Hidden" UseLayoutRounding="False" MaxWidth="200" LostKeyboardFocus="EnterAplhabetTextBox_LostKeyboardFocus" Height="21" />
            <Label Content="KEY VARIANT" BorderThickness="0.5,0.5,0.5,1" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="5,0,5,0" Width="200" Height="22" Background="#FF468FDC" Foreground="#FFFFFFFA" FontFamily="Dubai" FontSize="13" FontWeight="Bold" HorizontalContentAlignment="Stretch" UseLayoutRounding="False" BorderBrush="Black" Margin="0,86,0,0" />
            <Button x:Name="RepeatingKeyButton" Content="Repeating" HorizontalAlignment="Left" Margin="0,108,0,0" VerticalAlignment="Top" BorderBrush="Black" Foreground="#BF323232" Background="#FFF4F4F4" FontFamily="Dubai" FontSize="13" FontWeight="Bold" MinWidth="100" MaxWidth="100" MaxHeight="21" Height="21" BorderThickness="0.5,0,0.5,0.5" VerticalContentAlignment="Top" Padding="1,1,1,1" HorizontalContentAlignment="Center" ScrollViewer.CanContentScroll="True" Click="RepeatingKeyButton_Click" IsEnabled="False"/>
            <Button x:Name="AutokeyButton" Content="Autokey" HorizontalAlignment="Left" Margin="100,108,0,0" BorderBrush="Black" Foreground="#BF323232" Background="White" FontFamily="Dubai" FontSize="13" FontWeight="Bold" MinWidth="100" MaxWidth="100" MaxHeight="21" BorderThickness="0.5,0,0.5,0.5" VerticalContentAlignment="Top" Padding="1,1,1,1" HorizontalContentAlignment="Center" ScrollViewer.CanContentScroll="True" Click="AutokeyButton_Click"/>
        </Grid>
    </Grid>
</Window>
