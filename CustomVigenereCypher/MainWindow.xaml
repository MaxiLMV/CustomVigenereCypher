<Window x:Class="CustomVigenereCypher.VigenereMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomVigenereCypher"
        mc:Ignorable="d"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Custom Vigenere Cipher" Height="450" Width="800">
    <Grid Background="#FF182C42">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ResultingMessageTextBox" Margin="0,42,42,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="200" Initialized="ResultingMessageTextBox_Initialized" Cursor="Arrow" Background="White" Foreground="#BF323232" FontFamily="Dubai" Padding="5,5,5,5" FontSize="16" SelectionBrush="#FF182C42" SelectionTextBrush="#FF182C42" BorderBrush="#FF182C42" HorizontalAlignment="Right" Width="200" FontWeight="Bold"/>
        <Button x:Name="SwapButton" Content="Swap" HorizontalAlignment="Center" Margin="0,282,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="14" FontWeight="Bold" BorderBrush="Black" Foreground="White" Background="#FF3671B0" Padding="10" BorderThickness="0,0,0,0" Cursor="Hand" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" HorizontalContentAlignment="Center" MaxWidth="200" MaxHeight="50" Click="SwapButton_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <xctk:WatermarkTextBox x:Name="EnterCypherKeyTextBox" Watermark="Enter the key here" Margin="0,84,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="88" Height="36" Background="#FF3671B0" Foreground="White" FontFamily="Arial" HorizontalAlignment="Center" HorizontalContentAlignment="Stretch" Padding="5,5,5,5" Grid.IsSharedSizeScope="True" FontSize="9" TextChanged="EnterCypherKeyTextBox_TextChanged">
            <xctk:WatermarkTextBox.WatermarkTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" FontFamily="Dubai" Foreground="White" Focusable="False" />
                </DataTemplate>
            </xctk:WatermarkTextBox.WatermarkTemplate>
        </xctk:WatermarkTextBox>
        <xctk:WatermarkTextBox x:Name="EnterMessageTextBox" Watermark="Enter message to encrypt" Margin="42,42,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" Height="200" Background="White" Foreground="#BF323232" FontFamily="Dubai" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Padding="5,5,5,5" Grid.IsSharedSizeScope="True" RenderTransformOrigin="0.5,0.5" SelectionBrush="#FF182C42" SelectionTextBrush="#FF182C42" BorderBrush="#FF182C42" FontSize="16" FontWeight="Bold" TextChanged="EnterMessageTextBox_TextChanged">
            <xctk:WatermarkTextBox.WatermarkTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" FontFamily="Dubai" Foreground="#BF2F2F2F" Focusable="False" />
                </DataTemplate>
            </xctk:WatermarkTextBox.WatermarkTemplate>
        </xctk:WatermarkTextBox>
    </Grid>
</Window>
